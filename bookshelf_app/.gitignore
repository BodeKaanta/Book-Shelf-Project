# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables — never commit API keys
.env

# Release signing — leaking these lets someone publish updates as Bookedex,
# and it cannot be revoked. Losing them means never updating the app again:
# keep a backup somewhere off this machine.
android/key.properties
*.jks
*.keystore

# Desktop platforms — not build targets (#87). The scaffolding is deleted,
# but flutter pub get still regenerates plugin registrants into these paths.
# Left untracked they reappeared on every pub get, making a clean main read
# as dirty.
/linux/
/macos/
/windows/
